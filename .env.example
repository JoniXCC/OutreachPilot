# ---------------------------------------------------------------------------
# AI Sales Outreach Agent - configuration
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Mode -------------------------------------------------------------------
# DEMO_MODE=true: nothing is ever sent through Gmail. A local fake mailbox
# (data/demo_mailbox.json) is used instead so the full flow can be demonstrated.
DEMO_MODE=true

# SAFE_MODE=true: every generated email must be approved by a human in the
# dashboard before it can be sent. Automatic sending requires BOTH
# SAFE_MODE=false AND "auto-send" enabled on the campaign.
SAFE_MODE=true

# --- AI provider --------------------------------------------------------------
# gemini | groq | mock   (mock = deterministic offline provider, no API key)
AI_PROVIDER=gemini
# Optional automatic fallback when the primary provider fails / is rate limited
AI_FALLBACK_PROVIDER=groq

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

AI_TEMPERATURE=0.3
AI_MAX_OUTPUT_TOKENS=600
AI_TIMEOUT_SECONDS=30
AI_CACHE_ENABLED=true

# --- Gmail API ----------------------------------------------------------------
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
# How far back the inbox monitor looks for replies
INBOX_LOOKBACK_DAYS=14

# --- Sender identity (added to every email by Python, not by the AI) -----------
SENDER_NAME=Your Name
SENDER_TITLE=
# Adds "If this isn't relevant, just reply 'unsubscribe'..." to first emails
INCLUDE_OPT_OUT_LINE=true

# --- Database -----------------------------------------------------------------
DATABASE_URL=sqlite:///data/outreach.db

# --- Sending safety limits -------------------------------------------------------
MAX_EMAILS_PER_DAY=20
MIN_SECONDS_BETWEEN_EMAILS=90
MAX_FOLLOWUPS=2
FOLLOWUP_1_DAYS=3
FOLLOWUP_2_DAYS=5

# Replies classified below this confidence go to human review
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7

# --- Company research -------------------------------------------------------------
RESEARCH_TIMEOUT_SECONDS=10
RESEARCH_MAX_PAGES=2
RESEARCH_MAX_CHARS=3500
RESEARCH_MIN_SECONDS_BETWEEN_REQUESTS=2
RESEARCH_RESPECT_ROBOTS_TXT=true

# --- Optional REST API (python run.py api) ------------------------------------------
# If set, requests must send header "X-API-Token: <value>". The API binds to 127.0.0.1.
API_TOKEN=

# --- Logging ---------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=data/logs/app.log
